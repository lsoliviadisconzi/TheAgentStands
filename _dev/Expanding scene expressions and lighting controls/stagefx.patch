+.fx-prop svg .t{fill:var(--tag);stroke:none;font:700 40px "Barlow Condensed",sans-serif}
+@keyframes fx-pop{from{transform:scale(.5);opacity:0}}
+@keyframes fx-bob{50%{transform:translateY(-2.5cqw)}}
