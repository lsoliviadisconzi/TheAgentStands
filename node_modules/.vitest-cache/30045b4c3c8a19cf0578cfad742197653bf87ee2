		if (fx.color) push("lightColor", l.id, fx.color);
		if (fx.room) push("room", l.id, fx.room);
		if (fx.propL) push("propL", l.id, fx.propL === REMOVE ? null : fx.propL);
		if (fx.propR) push("propR", l.id, fx.propR === REMOVE ? null : fx.propR);
	};
	return cues;
}

